    "luckPerLevel": 0.6
  },
  "streak": {
    "_comment": "連続倍率 M(n) = base ^ (n / divisor)。実獲得数量 = floor(基本獲得数量 × 採集量倍率 × M)。素材ポイントにも M を掛ける(仕様6)",
    "base": 2,
    "divisor": 10
  },
