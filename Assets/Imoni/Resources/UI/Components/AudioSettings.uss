.audio-volume { margin-top: 14px; }
.audio-volume__heading { flex-direction: row; justify-content: space-between; font-size: 14px; -unity-font-definition: var(--font-body-black); }
.audio-volume__controls { flex-direction: row; align-items: center; margin-top: 8px; }
.audio-volume__step { width: 44px; min-width: 44px; height: 44px; padding: 0; font-size: 20px; }
.audio-volume__bar { flex-grow: 1; margin-left: 12px; margin-right: 12px; }
