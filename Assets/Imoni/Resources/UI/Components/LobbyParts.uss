.waiting-slot { flex-shrink: 0; }
.waiting-slot__empty { position: relative; flex-direction: row; align-items: center; padding: 12px; min-height: 74px; border-radius: 14px; background-color: var(--c-sand-light); }
.waiting-slot__outline { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.waiting-slot__icon { position: relative; width: 50px; height: 50px; flex-shrink: 0; margin-right: 12px; }
.waiting-slot__pulse { position: absolute; background-color: var(--c-green); border-radius: 44px; }
.waiting-slot__circle { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-radius: 25px; background-color: var(--c-sand-light); }
.waiting-slot__caption { font-size: 14px; -unity-font-definition: var(--font-body-black); color: var(--c-locked-fg); }
.loading-member { align-items: center; flex-shrink: 0; }
.loading-member__name { margin-top: 4px; font-size: 11px; -unity-font-definition: var(--font-body-black); }
.loading-member .status-badge { margin-top: 4px; font-size: 10px; border-radius: 8px; padding: 1px 6px; }
