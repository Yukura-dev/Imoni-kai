/* Gallery framing is development UI. Every sample uses the production component stylesheet. */
.imoni-app { background-color: var(--c-yellow); }
.unity-label { margin: 0; padding: 0; }
.component-gallery { flex-grow: 1; min-height: 0; color: var(--c-brown); }
.gallery-title { font-size: 22px; -unity-font-definition: var(--font-title); margin: 12px 18px 6px 18px; }
.gallery-jump { margin: 0 18px 4px 18px; min-height: 32px; flex-shrink: 0; }
.gallery-feedback { font-size: 12px; margin: 0 18px 8px 18px; white-space: normal; }
.gallery-scroll { flex-grow: 1; min-height: 0; }
.gallery-scroll > .unity-scroll-view__content-viewport { overflow: hidden; }
.gallery-section { margin: 0 18px 24px 18px; flex-shrink: 0; }
.gallery-section-title { font-size: 20px; -unity-font-definition: var(--font-title); border-bottom-width: 3px; border-bottom-color: var(--c-brown); padding-bottom: 8px; margin-bottom: 10px; }
.gallery-sample { margin-bottom: 16px; flex-shrink: 0; }
.gallery-caption { font-size: 12px; margin-bottom: 6px; color: var(--c-brown-soft); }
.gallery-row { flex-direction: row; align-items: center; justify-content: space-between; }
.gallery-pattern { height: 156px; position: relative; }
