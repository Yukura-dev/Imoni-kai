.main-page { flex-grow: 1; position: relative; background-color: var(--c-yellow); }
.main-pattern { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.main-logo { position: absolute; left: 24px; top: 158px; width: 320px; height: 160px; background-size: contain; }
.main-settings { position: absolute; right: 18px; top: 52px; width: 44px; height: 44px; margin: 0; padding: 0; border-width: 3px; border-color: var(--c-brown); border-radius: 12px; background-color: var(--c-cream); }
.main-settings > .imoni-button__icon { width: 22px; height: 22px; }
.main-tagline { position: absolute; left: 36px; right: 36px; top: 316px; font-size: 15px; white-space: nowrap; }
.main-loading { position: absolute; left: 32px; right: 32px; bottom: 96px; align-items: center; }
.main-progress { width: 100%; height: 18px; border-radius: 9px; background-color: var(--c-cream); margin-bottom: 14px; }
.main-loading-label { height: 44px; font-size: 14px; -unity-text-align: middle-center; }
.main-start { display: none; width: 200px; height: 44px; padding: 0 28px; border-radius: 22px; border-bottom-width: 0; font-size: 16px; -unity-font-definition: var(--font-body-black); white-space: nowrap; }
.onboarding-page { flex-grow: 1; padding: 64px 22px 48px 22px; background-color: var(--c-yellow); }
.onboarding-page > * { flex-shrink: 0; }
.onboarding-page--first > .tutorial-block { margin-bottom: 24px; }
.onboarding-page--second > .tutorial-block { margin-bottom: 16px; }
.onboarding-page--third > .tutorial-block { margin-bottom: 14px; }
.onboarding-spacer { flex-grow: 1; min-height: 0; }
.tutorial-introduction { font-size: 15px; white-space: normal; }
.tutorial-timeline-card { padding: 16px; }
.tutorial-timeline-spaced { margin-bottom: 12px; }
.tutorial-outcomes { flex-direction: row; }
.tutorial-outcome { flex-grow: 1; flex-basis: 0; min-width: 0; }
.tutorial-outcome--first { margin-right: 10px; }
.tutorial-clear-condition { font-size: 14px; -unity-font-definition: var(--font-body-black); -unity-text-align: middle-center; white-space: normal; }
.tutorial-quality-card, .tutorial-streak { padding: 14px 16px; }
.tutorial-card-heading { font-size: 15px; -unity-font-definition: var(--font-body-black); white-space: normal; }
.tutorial-qualities { flex-direction: row; flex-wrap: wrap; margin-top: 10px; margin-bottom: 4px; }
.tutorial-qualities > .quality-chip { margin-right: 6px; margin-bottom: 6px; }
.tutorial-quality-caption { font-size: 12px; color: var(--c-brown-soft); white-space: normal; }
.tutorial-streak > .imoni-card__content { flex-direction: row; align-items: center; }
.tutorial-mascot { width: 96px; height: 100px; flex-shrink: 0; margin-right: 12px; background-size: contain; }
.tutorial-streak-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.tutorial-streak-description { margin-top: 4px; font-size: 13px; white-space: normal; }
.tutorial-upgrades { border-width: 3px; border-radius: 16px; padding: 12px 14px; }
.tutorial-upgrades-row { flex-direction: row; }
.tutorial-upgrades-row--first { margin-bottom: 8px; }
.tutorial-upgrade--first { margin-right: 8px; }
.tutorial-cheer { font-size: 20px; color: var(--c-red); -unity-font-definition: var(--font-title); -unity-text-align: middle-center; white-space: nowrap; }
