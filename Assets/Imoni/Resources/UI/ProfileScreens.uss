/* Screen composition from Home, Member and Ranking mocks. Reusable detail stays in component styles. */
.profile-screen { flex-grow: 1; min-height: 0; background-color: var(--c-yellow); overflow: hidden; }
.profile-tabs { height: 79px; }
.home-header { padding: 52px 18px 14px; flex-direction: row; align-items: center; flex-shrink: 0; }
.home-profile { flex-grow: 1; min-width: 0; margin-left: 12px; margin-right: 12px; }
.home-name { margin-top: 3px; font-size: 18px; -unity-font-definition: var(--font-body-black); }
.home-settings { width: 44px; height: 44px; border-width: 3px; border-color: var(--c-brown); border-radius: 12px; background-color: var(--c-cream); }
.home-settings > .imoni-button__icon { width: 22px; height: 22px; left: 8px; }
.home-main { flex-grow: 1; min-height: 0; padding: 0 18px 18px; }
.home-hero { flex-grow: 1; flex-shrink: 1; min-height: 0; padding: 0; border-radius: 26px; overflow: hidden; }
.home-hero > .imoni-card__content { align-items: center; justify-content: center; }
.home-title { margin-top: 6px; -unity-font-definition: var(--font-title); font-size: 34px; color: var(--c-red); white-space: nowrap; }
.home-team { margin-top: 6px; font-size: 13px; }
.home-stats { flex-direction: row; flex-shrink: 0; margin-top: 14px; }
.home-stats > .stat-card { flex-grow: 1; flex-basis: 0; min-width: 0; }
.home-stat-spaced { margin-left: 8px; }
.home-play { height: 78px; border-bottom-width: 6px; border-radius: 39px; font-size: 26px; margin-top: 14px; padding-left: 36px; padding-right: 0; }
.home-play > .imoni-button__icon { width: 26px; height: 26px; left: 50%; translate: -83px -50%; }
.home-modes { margin-top: 8px; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.home-mode-pill { padding: 4px 10px; border-width: 2px; border-color: var(--c-brown); border-radius: 16px; background-color: var(--c-cream); font-size: 12px; -unity-font-definition: var(--font-body-black); }
.home-mode-pill--locked { margin-left: 8px; background-color: #EFD38A; border-color: #8C6A2E; color: #5C4518; }
.home-settings-overlay { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(74,46,34,0.5); }
.home-settings-card { width: 320px; }
.home-settings-close { margin-top: 14px; }
.member-main { flex-grow: 1; min-height: 0; padding: 52px 16px 12px; }
.member-title-picker { flex-shrink: 0; margin-top: 7px; }
.member-avatar-editor { flex-grow: 1; min-height: 0; margin-top: 12px; }
.ranking-main { flex-grow: 1; min-height: 0; padding: 52px 16px 12px; }
.ranking-title { font-size: 26px; -unity-font-definition: var(--font-title); color: var(--c-green); }
.ranking-section { margin-top: 10px; }
.ranking-caption-row { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.ranking-caption { font-size: 11px; -unity-font-definition: var(--font-body-black); }
.ranking-team-size { font-size: 11px; -unity-font-definition: var(--font-body-black); padding: 2px 8px; background-color: var(--c-cream); border-width: 2px; border-color: var(--c-brown); border-radius: 12px; flex-shrink: 0; }
.ranking-mine { border-width: 0; border-radius: 16px; padding: 10px 14px; background-color: var(--c-green); color: var(--c-cream); }
.ranking-mine > .imoni-card__content { flex-direction: row; align-items: center; justify-content: space-between; }
.ranking-mine-description { flex-grow: 1; min-width: 0; margin-right: 10px; }
.ranking-mine-team { font-size: 14px; -unity-font-definition: var(--font-body-black); }
.ranking-mine-note { font-size: 11px; color: #DCE8C4; margin-top: 2px; }
.ranking-mine-state { font-size: 13px; -unity-font-definition: var(--font-body-black); color: var(--c-yellow); white-space: nowrap; flex-shrink: 0; }
