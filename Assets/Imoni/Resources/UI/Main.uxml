<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:c="Imoni.Game.UI.Components">
    <ui:VisualElement class="main-page">
        <c:PatternBackground variant="Yellow" class="main-pattern" picking-mode="Ignore" />
        <c:TitleLogo class="main-logo" picking-mode="Ignore" />
        <c:ImoniButton name="settings" variant="Icon" icon="icon_settings" tooltip="設定" class="main-settings" />
        <c:ImoniText text="リモートでつながる、秋の鍋あそび" class="main-tagline" />
        <ui:VisualElement class="main-loading">
            <c:ProgressBar name="loading-progress" variant="Thick" value="0" class="main-progress" />
            <c:ImoniText name="loading-label" text="よみこみ中… 0%" class="main-loading-label" />
            <c:ImoniButton name="start" variant="Primary" text="タップしてはじめる" class="main-start" />
        </ui:VisualElement>
        <c:SettingsDialog name="settings-dialog" />
    </ui:VisualElement>
</ui:UXML>
